# ThermPro — local development environment
# Copy this file to .env and adjust values as needed.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
THERMPRO_DATABASE_URL=postgresql+psycopg://thermpro:thermpro@localhost:5432/thermpro

# ─── Object storage (MinIO in development, AWS S3 in production) ─────────────
THERMPRO_S3_ENDPOINT_URL=http://localhost:9000
THERMPRO_S3_ACCESS_KEY_ID=minioadmin
THERMPRO_S3_SECRET_ACCESS_KEY=minioadmin
THERMPRO_S3_BUCKET_ARTIFACTS=thermpro-artifacts
THERMPRO_S3_REGION=us-east-1

# ─── Application ─────────────────────────────────────────────────────────────
THERMPRO_DEBUG=false
THERMPRO_LOG_LEVEL=INFO

# ─── Authentication ───────────────────────────────────────────────────────────
# Set to true for local dev (no JWT required — all requests authenticated as dev admin)
THERMPRO_DEV_AUTH_ENABLED=true
# Change in production:
# THERMPRO_DEV_AUTH_ENABLED=false
# THERMPRO_JWT_SECRET=change-me-in-production
